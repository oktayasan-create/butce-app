// EXAMPLE ONLY — do not deploy until OWNER_UID is replaced with your Firebase Authentication UID.
// Keep the currently published deny-all rules until the app login is tested.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_YOUR_FIREBASE_AUTH_UID';
    }
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
